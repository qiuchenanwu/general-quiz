# general-quiz · 后端环境变量模板
#
# 复制为 .env 并按需修改。本地开发可全部留空（默认值就够了）。

# ===== 基础 =====
# DEBUG=1
# QUIZ_SECRET_KEY=please-generate-a-real-one
# QUIZ_ALLOWED_HOSTS=127.0.0.1,localhost,your.domain
# QUIZ_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,https://your.domain
# QUIZ_ENV=prod

# ===== 数据库 =====
# QUIZ_DB=postgres
# QUIZ_PG_NAME=quiz
# QUIZ_PG_USER=quiz
# QUIZ_PG_PASSWORD=
# QUIZ_PG_HOST=127.0.0.1
# QUIZ_PG_PORT=5432

# ===== 账号与注册 =====
# QUIZ_SIGNUP_MODE=open      # open | key | closed
# QUIZ_SIGNUP_KEY=
# QUIZ_LOGIN_PER_IP=20
# QUIZ_LOGIN_PER_NAME=8
# QUIZ_SIGNUP_PER_IP=5
# QUIZ_AUTH_WINDOW=600

# ===== Java 真跑（默认关，公网千万别开）=====
# QUIZ_JAVA_ENABLED=0
# QUIZ_JAVA_TIMEOUT=20
# QUIZ_JAVA_MEMORY_MB=128

# ===== 提权（"站内自己解锁 Java"）=====
# 设了密码 = 启用提权功能；不设 = 没有这个功能 = Java 永远 403
# QUIZ_ELEVATE_PASSWORD=
# QUIZ_ELEVATE_TTL=1800
# QUIZ_ELEVATE_TRIES=8

# ===== AI 功能（默认全部禁用）=====
# 把 QUIZ_LLM_DISABLED=1 拿掉 + 配 QUIZ_LLM_API_KEY，AI 立刻启用
# QUIZ_LLM_DISABLED=1
# QUIZ_LLM_API_KEY=sk-...
# QUIZ_LLM_BASE_URL=https://api.deepseek.com/v1
# QUIZ_LLM_MODEL=deepseek-chat
# QUIZ_LLM_TIMEOUT=90
# QUIZ_LLM_LOCAL_COOLDOWN=600
# QUIZ_LLM_DISABLE_LOCAL=0

# ===== 路径 =====
# 默认值通常不用改
# QUIZ_FRONTEND_DIST=../quiz-frontend/dist
# QUIZ_PARSER_PATH=./tools/pdf_to_json.py
# QUIZ_CACHE_DIR=./.quiz-cache
# QUIZ_JAVA_SANDBOX=./tools/java_sandbox.py
# QUIZ_LOG_DIR=./logs
